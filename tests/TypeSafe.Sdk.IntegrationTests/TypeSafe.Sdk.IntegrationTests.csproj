<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live integration tests against the real TypeSafe AI API. Every test is gated on TYPESAFE_API_KEY
    and reports itself as skipped when the key is absent, so this project is safe to run in CI, where
    no key is configured. The two tests that need a valid key have never been executed: none was
    available on the machine they were written on, so they are written to pass against the live API
    but that has not been verified, and the first run with a real key is the verification. The
    bad-key test needs no credential and has been run against the live API.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TypeSafe.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TypeSafe.Sdk/TypeSafe.Sdk.csproj" />
  </ItemGroup>

</Project>
