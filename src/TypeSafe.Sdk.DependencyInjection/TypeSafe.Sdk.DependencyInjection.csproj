<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TypeSafe.DependencyInjection</RootNamespace>
    <AssemblyName>TypeSafe.Sdk.DependencyInjection</AssemblyName>
    <PackageId>TypeSafe.Sdk.DependencyInjection</PackageId>
    <Version>0.7.0</Version>
    <Authors>Biztactix-Ryan</Authors>
    <Description>Dependency-injection registration for the unofficial C# SDK for the TypeSafe AI API: services.AddTypeSafeClient() with IHttpClientFactory and the options pattern.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Biztactix-Ryan/TypeSafe.Sdk.C-</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Biztactix-Ryan/TypeSafe.Sdk.C-.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>typesafe;sdk;api;ai;dependencyinjection;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TypeSafe.Sdk/TypeSafe.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="TypeSafe.Sdk.DependencyInjection.Tests" />
  </ItemGroup>

</Project>
